{
  "hosting": [
    {
      "target": "realmhunt",
      "public": "realmhunt",
      "cleanUrls": true,
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "**/.DS_Store",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/i/**",
          "destination": "/invite.html"
        }
      ],
      "headers": [
        {
          "source": "/.well-known/apple-app-site-association",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      ]
    },
    {
      "target": "root",
      "public": "root",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "**/.*",
        "**/node_modules/**"
      ]
    }
  ]
}
