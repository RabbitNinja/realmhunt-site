{
  "hosting": [
    {
      "target": "realmhunt",
      "public": "realmhunt",
      "cleanUrls": true,
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "**/.*",
        "**/node_modules/**"
      ]
    },
    {
      "target": "root",
      "public": "root",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "**/.*",
        "**/node_modules/**"
      ]
    }
  ]
}
